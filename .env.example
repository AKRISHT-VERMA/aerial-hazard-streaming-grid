# Optional PostgreSQL connection string. Keep real credentials in your local
# environment; never commit a populated .env file.
DATABASE_URL=

# Optional trusted scikit-learn SVM pipeline artifact. If unset, the server
# runs the explicitly labeled synthetic demonstration threshold scorer.
HAZARD_MODEL_PATH=

# Weather source: live (default) or synthetic demo.
HAZARD_WEATHER_SOURCE=live
HAZARD_HTTP_HOST=127.0.0.1
HAZARD_HTTP_PORT=8000
HAZARD_UDP_HOST=127.0.0.1
HAZARD_UDP_PORT=9999

# In-memory retention limits. Active-alert cells are pinned; if every cell at
# capacity is fresh or alert-pinned, the new frame is dropped and counted.
HAZARD_GRID_MAX_CELLS=10000
HAZARD_CELL_RETENTION_SECONDS=300
HAZARD_GRID_MAX_DRONES_PER_CELL=256
HAZARD_PREDICTION_MAX_ENTRIES=10000
HAZARD_PREDICTION_RETENTION_SECONDS=300

# Live weather cache expires after this interval and uses a bounded LRU cache.
HAZARD_WEATHER_CACHE_SECONDS=60
HAZARD_WEATHER_CACHE_MAX_ENTRIES=1024

